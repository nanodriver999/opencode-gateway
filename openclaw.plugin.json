{
  "id": "opencode-gateway",
  "name": "OpenCode Gateway",
  "description": "Use OpenAI-compatible OpenCode Gateway models in OpenClaw",
  "version": "0.1.0",
  "providers": [
    "opencode-gateway"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "default": "http://127.0.0.1:3000/v1"
      },
      "apiKey": {
        "type": "string"
      },
      "contextWindow": {
        "type": "integer",
        "minimum": 1024,
        "default": 8192
      },
      "maxTokens": {
        "type": "integer",
        "minimum": 1,
        "default": 2048
      }
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "Gateway API Key",
      "sensitive": true
    },
    "baseUrl": {
      "label": "Gateway Base URL"
    }
  }
}
