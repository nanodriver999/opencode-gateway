{
  "name": "opencode-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:contract": "tsc --target es2022 --module NodeNext --moduleResolution NodeNext --outDir build src/openai/chat-contract.ts && node --test tests/chat-contract.node.mjs",
    "test:e2e": "node scripts/e2e-free-model.mjs"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.0.0",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "openai": "^6.0.0"
  },
  "openclaw": {
    "extensions": [
      "./openclaw/plugin.mjs"
    ]
  }
}
